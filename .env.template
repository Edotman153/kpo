# Скопируй в .env и заполни: cp .env.template .env

# Значения пиши без кавычек.

# Токен бота от @BotFather в Telegram (обязательно для запуска бота)
TELEGRAM_TOKEN=

# Ключ Google Books API (необязателен, но с ним лимиты выше)
GOOGLE_BOOKS_API_KEY=

# Строка подключения к БД. Нужна только при запуске без Docker-скриптов
# (скрипты подставляют её сами). Для быстрого старта без Postgres:
# DB_URL=sqlite:///books.db
DB_URL=postgresql+psycopg2://user:pass@localhost:5434/books
